# Production environment TEMPLATE — safe to commit.
#
# Copy to .env.production (gitignored) and fill in every CHANGE-ME:
#
#     cp .env.production.example .env.production
#
# Used for both compose variable substitution and the container's own
# environment, so pass it explicitly:
#
#     docker compose --env-file .env.production up -d
#
# ----------------------------------------------------------------------------
# 1. SET THIS FIRST
# ----------------------------------------------------------------------------
# The public address browsers will use to reach the server. Everything below
# that says CHANGE-ME derives from it. Use the domain if you have one, or the
# server's public IP. No trailing slash.
DEPLOY_HOST=CHANGE-ME.example.com

# ----------------------------------------------------------------------------
# 2. Public URLs — must be reachable from the user's browser, not from inside
#    the container. Replace CHANGE-ME with DEPLOY_HOST above (compose does not
#    expand variables inside this file, so they are written out in full).
# ----------------------------------------------------------------------------
# Baked into the frontend bundle at build time. Change it and rebuild:
#   docker compose --env-file .env.production build frontend
NEXT_PUBLIC_API_URL=http://CHANGE-ME.example.com:8000

# Origins the API accepts browser requests from. Must include the frontend URL.
CORS_ORIGINS=http://CHANGE-ME.example.com:3000

# Presigned URLs for frames and clips sign their own Host header, so this must
# be the address the browser fetches them from — never 127.0.0.1.
MINIO_PUBLIC_ENDPOINT=CHANGE-ME.example.com:9000

# ----------------------------------------------------------------------------
# 3. Secrets — generate fresh values; never reuse an example.
# ----------------------------------------------------------------------------
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token_urlsafe-48
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

POSTGRES_USER=root
POSTGRES_PASSWORD=CHANGE-ME-strong-db-password
POSTGRES_DB=vision_db

MINIO_ACCESS_KEY=CHANGE-ME-minio-access-key
MINIO_SECRET_KEY=CHANGE-ME-minio-secret-key
MINIO_BUCKET_NAME=vision-bucket
MINIO_MEDIA_BUCKET=vision-media
MINIO_SECURE=false

# ----------------------------------------------------------------------------
# 4. Docker Hub — for pushing the two images. Used by docker/push-images.sh,
#    never read by the running application and never baked into an image.
#    Create one at hub.docker.com > Account Settings > Personal access
#    tokens. Never commit it.
# ----------------------------------------------------------------------------
DOCKER_USERNAME=your-dockerhub-username
DOCKER_PASSWORD=your-dockerhub-personal-access-token

# Naming the images after the Hub repo is what makes `docker compose push` and
# `docker compose pull` work directly — no separate tagging step.
#   docker compose --env-file .env.production build
#   docker compose --env-file .env.production push
# api + worker (the split stack). Built from the Dockerfile's `service`
# target: app + models, no bundled database.
BACKEND_IMAGE=your-dockerhub-username/sentinelai-backend:latest
FRONTEND_IMAGE=your-dockerhub-username/sentinelai-frontend:latest

# Only used by `--profile aio`: the single-container build that bundles
# PostgreSQL, Redis and MinIO into the app image. Same repo, different tag.
BACKEND_AIO_IMAGE=your-dockerhub-username/sentinelai-backend:allinone

# ----------------------------------------------------------------------------
# 5. Application
# ----------------------------------------------------------------------------
APP_NAME=Authentication API
DEBUG=false

# Published host ports. Change these if the server already uses one; if you
# change API_PORT or MINIO_PORT, update the public URLs in section 2 to match.
API_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5434
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# CPU wheels. For an NVIDIA GPU set the cu126 index and uncomment the
# `deploy.resources` block on `backend` in docker-compose.yml.
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# Bakes Qwen2.5-VL into the image for the `model=qwen` detection backend.
# 7B = 16.6 GB, 3B = 7.5 GB on top of the base image. It is the LAST stage of a
# fallback that only runs when Gemini is unreachable, so leaving this false
# costs no coverage while Gemini has quota.
INCLUDE_QWEN_VL=false
QWEN_VL_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct

# ----------------------------------------------------------------------------
# 6. Email — signup OTP. Without SMTP_USER/SMTP_PASSWORD the OTP is only
#    written to the container log, which means nobody can complete signup.
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE-ME@gmail.com
SMTP_PASSWORD=CHANGE-ME-16-char-app-password
SMTP_FROM=CHANGE-ME@gmail.com
OTP_EXPIRY_MINUTES=10

# Admin account seeded on first boot.
ADMIN_EMAIL=admin@example.com

# ----------------------------------------------------------------------------
# 7. Models. All four detection models are baked into the backend image, so
#    nothing is downloaded at run time. Gemini is the exception: it is a hosted
#    API and the only path that detects harassment.
# ----------------------------------------------------------------------------
GEMINI_API_KEY=CHANGE-ME-gemini-api-key
GEMINI_MODEL=gemini-flash-latest
CHAT_MODEL=gemini-flash-latest
CHAT_HISTORY_TURNS=12
CHAT_MAX_FRAMES=6

ACTION_MODEL_ID=OPear/videomae-large-finetuned-UCF-Crime
ACTION_NUM_FRAMES=16
ACTION_PEAK_MARGIN=0.05
VIOLENCE_PEAK_MARGIN=0.05
MAX_INCIDENT_COVERAGE=0.8

# The Qwen chat agent needs an OpenAI-compatible server, which is NOT part of
# the backend image. Leave the fallback off in production: the offline path
# takes minutes per reply and would tie up a worker.
QWEN_CHAT_BASE_URL=http://localhost:11434/v1
QWEN_CHAT_API_KEY=ollama
QWEN_CHAT_MODEL=qwen2.5:3b
QWEN_CHAT_TIMEOUT_S=180
QWEN_CHAT_ALLOW_LOCAL_FALLBACK=false

# ----------------------------------------------------------------------------
# 8. Pipeline tuning
# ----------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
PRESIGNED_URL_TTL_SECONDS=3600
FRAME_SAMPLE_COUNT=12
JOB_MAX_TRIES=2
JOB_TIMEOUT_SECONDS=1800
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=5

# ----------------------------------------------------------------------------
# 9. Internal addresses. In the default split stack the API reaches the
#    backing services by compose service name; with --profile aio they are all
#    on loopback inside one container. docker-compose.yml sets both — listed
#    here for reference only.
# ----------------------------------------------------------------------------
# DATABASE_URL=postgresql://root:...@127.0.0.1:5432/vision_db
# REDIS_URL=redis://127.0.0.1:6379/0
# MINIO_ENDPOINT=127.0.0.1:9000
