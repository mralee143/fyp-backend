# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# JWT Configuration
SECRET_KEY=your-secret-key-here-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Configuration
APP_NAME=Authentication API
DEBUG=false

# CORS Configuration (comma-separated Next.js frontend origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email / SMTP Configuration
# Gmail: use an App Password (Google Account > Security > App passwords), not your login password.
# Leave SMTP_USER/SMTP_PASSWORD blank to run in dev mode (OTP is logged to the console instead of emailed).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=your-email@gmail.com
OTP_EXPIRY_MINUTES=10

# MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=vision-bucket
MINIO_SECURE=false
