# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# JWT Configuration
SECRET_KEY=your-secret-key-here-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Configuration
APP_NAME=Authentication API
DEBUG=false

# CORS Configuration (comma-separated Next.js frontend origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email / SMTP Configuration
# Gmail: use an App Password (Google Account > Security > App passwords), not your login password.
# Leave SMTP_USER/SMTP_PASSWORD blank to run in dev mode (OTP is logged to the console instead of emailed).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=your-email@gmail.com
OTP_EXPIRY_MINUTES=10

# Gemini (LLM video violence detection) — get a free key at https://aistudio.google.com/apikey
# Required for /detection/video/llm. This is the only path that detects
# HARASSMENT, which has no off-the-shelf classifier and is judged from context.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest

# Action recognition (/detection/video/action) — local, no API key.
# Recognises fighting/assault/abuse/robbery/shooting from the UCF-Crime classes.
# Downloaded and cached from the HF Hub on first use (~1.2 GB).
ACTION_MODEL_ID=OPear/videomae-large-finetuned-UCF-Crime
ACTION_NUM_FRAMES=16

# How incident sections are placed on the timeline. The video models slide a
# window across the clip, and neighbouring windows overlap, so without these a
# single incident merges outwards until it covers the whole video — one solid
# band that tells an operator nothing about where to look.
#   *_PEAK_MARGIN        floor under the cutoff that trims a flagged run down to
#                        its strongest windows. Raise for tighter sections.
#   MAX_INCIDENT_COVERAGE most of a video one section may cover before it is
#                        narrowed to the moment the model was most certain
#                        about. Set to 1 to store spans exactly as classified.
ACTION_PEAK_MARGIN=0.05
VIOLENCE_PEAK_MARGIN=0.05
MAX_INCIDENT_COVERAGE=0.8

# Qwen agent chatbot (/chat) — the model that drives the conversation and
# decides when to run detection or query the database.
# Easiest setup: install Ollama, then `ollama pull qwen2.5:3b`. Any
# OpenAI-compatible server works (vLLM, llama.cpp, DashScope) — point the base
# URL at it and set the matching model id.
# 3B on an 8 GB card leaves room for the detection models; use qwen2.5:7b only
# if the GPU is dedicated to chat.
QWEN_CHAT_BASE_URL=http://localhost:11434/v1
QWEN_CHAT_API_KEY=ollama
QWEN_CHAT_MODEL=qwen2.5:3b
QWEN_CHAT_TIMEOUT_S=180
# When the endpoint above is unreachable, run Qwen offline in qwen_env instead
# (reuses the cached Qwen2.5-VL weights). Correct but slow — minutes per reply.
QWEN_CHAT_ALLOW_LOCAL_FALLBACK=true
# The fallback loads 4-bit on the GPU only when the weights fit in *free* VRAM,
# otherwise it runs on CPU. On an 8 GB card the cached 7B needs the GPU mostly
# idle; point this at a smaller checkpoint (e.g. Qwen/Qwen2.5-3B-Instruct) if
# you want it to fit alongside a browser.
# QWEN_CHAT_LOCAL_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# VRAM left free for activations/KV cache, and the floor below which we skip
# the GPU entirely — both in GiB.
# QWEN_CHAT_VRAM_HEADROOM_GIB=1.0
# QWEN_CHAT_MIN_GPU_GIB=2.0

# Redis — job queue broker, response cache and the pub/sub channel behind the
# live progress stream. Started by `docker compose up -d redis`.
REDIS_URL=redis://localhost:6379/0

# Caching. Cached payloads carry presigned URLs, so CACHE_TTL_SECONDS must stay
# comfortably below PRESIGNED_URL_TTL_SECONDS or a cache hit can hand the
# browser an already-expired link.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
PRESIGNED_URL_TTL_SECONDS=3600

# Worker pipeline. FRAME_SAMPLE_COUNT is how many preview frames are extracted
# and streamed to the browser before detection starts — this is what makes
# images appear within a second or two of upload.
FRAME_SAMPLE_COUNT=12
JOB_MAX_TRIES=2
JOB_TIMEOUT_SECONDS=1800

# Outbound webhooks (POSTed to URLs registered at /webhooks/endpoints).
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=5

# Per-analysis chat agent (/detection/scans/{id}/chat). Falls back to the local
# Qwen server above, then to a plain readout of the stored analysis, so the
# panel still works with no API key.
CHAT_MODEL=gemini-flash-latest
CHAT_HISTORY_TURNS=12
CHAT_MAX_FRAMES=6

# MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=vision-bucket
# Separate bucket for pipeline media: videos, extracted frames, incident clips.
MINIO_MEDIA_BUCKET=vision-media
MINIO_SECURE=false
# Only needed when the API and the browser reach MinIO under different names —
# which is exactly the case in Docker, where the API connects to `minio:9000`
# but the browser can only resolve `localhost:9000`. Frames and clips are
# handed out as presigned URLs, and a presigned URL signs its own Host header,
# so it has to be signed against the address the browser will actually request.
# Leave blank when running from the venv (both are localhost:9000);
# docker-compose.yml sets it for you.
MINIO_PUBLIC_ENDPOINT=
