// Prisma Schema for Authentication System
// This defines the database schema and generates the type-safe Python client

generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  hashedPassword String   @map("hashed_password")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  images         Image[]
  scans          DetectionScan[]

  @@map("users")
}

model Image {
  id                Int      @id @default(autoincrement())
  userId            Int      @map("user_id")
  objectKey         String   @map("object_key")
  originalFilename  String   @map("original_filename")
  generatedFilename String   @map("generated_filename")
  mimeType          String   @map("mime_type")
  fileSize          Int      @map("file_size")
  uploadedAt        DateTime @default(now()) @map("uploaded_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("images")
  @@index([userId])
}

// A video uploaded for detection + its results (scan history).
model DetectionScan {
  id               Int      @id @default(autoincrement())
  userId           Int      @map("user_id")
  filename         String   @map("filename")
  model            String   @map("model") // yolo | owlv2 | action | llm
  violenceDetected Boolean  @default(false) @map("violence_detected")
  summary          String?  @map("summary")
  labels           String[] @default([]) @map("labels") // detected event labels
  result           Json     @map("result") // full detection response JSON
  videoUrl         String?  @map("video_url") // stored video location (if any)
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("detection_scans")
  @@index([userId])
}
